      ]
    },
    {
      "id": "mackinac-taken",
      "title": "Michilimackinac taken from the Americans",
      "kind": "fixed",
      "date": "1812-07-17",
      "keywords": [
        "Michilimackinac",
        "Mackinac",
        "Roberts",
        "Hanks",
        "war"
      ],
      "happens": [
        {
          "do": "town_falls",
          "town": "Mackinac Island",
          "to": "Crown"
        },
        {
          "do": "move_garrison",
          "from": "St. Joseph Island",
          "to": "Mackinac Island",
          "count": 40
        },
        {
          "do": "flag",
          "name": "mackinac_british"
        },
        {
          "do": "say",
          "text": "Michilimackinac is taken: Captain Roberts has the fort from the Americans without a shot fired.",
          "headline": true
        },
        {
          "do": "news",
          "from": "Michilimackinac",
          "to": "the wintering partner",
          "subject": "Michilimackinac is ours",
          "text": "Captain Roberts took the fort on the island on the 17th with our voyageurs and the Ojibwe and Odawa from St. Joseph. Not a shot fired. The upper country is open to us and shut to Astor.",
          "days": 40,
          "company": "NWC"
        }
      ]
    },
    {
      "id": "detroit-surrenders",
      "title": "General Hull surrenders Detroit to Brock and Tecumseh",
      "kind": "fixed",
      "date": "1812-08-16",
      "keywords": [
        "Detroit",
        "Hull",
        "Brock",
        "Tecumseh",
        "war"
      ],
      "happens": [
        {
          "do": "town_falls",
          "town": "Detroit",
          "to": "Crown"
        },
        {
          "do": "move_garrison",
          "from": "Amherstburg",
          "to": "Detroit",
          "count": 60
        },
        {
          "do": "kill",
          "who": "Lieutenant Porter Hanks",
          "cause": "at Detroit, by a round shot, waiting on his court of inquiry"
        },
        {
          "do": "flag",
          "name": "detroit_british"
        },
        {
          "do": "say",
          "text": "Detroit has surrendered: General Hull has given up the fort and the territory to General Brock and Tecumseh.",
          "headline": true
        },
        {
          "do": "news",
          "from": "Montreal",
          "to": "the wintering partner",
          "subject": "Detroit taken",
          "text": "Hull has surrendered Detroit and the whole of Michigan with it to General Brock. Tecumseh's people were with Brock. The Americans have nothing left on the upper lakes.",
          "days": 60,
          "company": "NWC"
        },
        {
          "do": "news",
          "from": "the Governor and Committee, London",
          "to": "the Factor at York Factory",
          "subject": "the American war goes well",
          "text": "Detroit and Michilimackinac are both taken from the Americans. The Canadians will have the upper lakes to themselves; watch their prices on the Saskatchewan.",
          "days": 330
        }
      ]
    },
    {
      "id": "queenston-heights",
