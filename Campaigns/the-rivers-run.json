    {
      "id": "the-committee-asks",
      "title": "The Committee asks about the brigades",
      "kind": "conditional",
      "repeat_days": 540,
      "rumour": "A letter from the Committee is on its way about the state of the river transport.",
      "when": [
        "var(troubles) >= 4"
      ],
      "happens": [
        {
          "do": "set",
          "var": "troubles",
          "to": 0
        },
        {
          "do": "news",
          "from": "the Governor and Committee, London",
          "to": "the Factor at York Factory",
          "subject": "the brigades",
          "text": "The Committee has counted the boats lost and late and does not like the sum. A careful man would find out why.",
          "days": 60
        },
        {
          "do": "tension",
          "add": 2,
          "why": "the Committee is displeased"
        }
      ]
    },
    {
      "id": "the-boatmen-talk",
      "title": "The boatmen talk of the man who rode with them",
      "kind": "conditional",
      "repeat_days": 365,
      "rumour": "The boatmen say the Factor's man is not afraid of the rapids.",
      "when": [
        "flag:deed:escort",
        "month:6-9"
      ],
      "happens": [
        {
          "do": "tension",
          "add": -2,
          "why": "the brigades are steadier"
        },
        {
          "do": "say",
          "text": "The boatmen speak of the man who rode in with them: where he goes, the boats keep their dates.",
          "to": "HBC"
        }
      ]
    },
    {
      "id": "the-courier-is-known",
      "title": "A man who can be trusted with a packet",
      "kind": "conditional",
      "repeat_days": 365,
      "rumour": "It is said you are the one to trust with a packet over the portage.",
      "when": [
        "flag:deed:courier"
      ],
      "happens": [
        {
          "do": "tension",
          "add": -1,
          "why": "the packets come through"
        },
        {
          "do": "say",
          "text": "A packet has been carried through the portages and come out dry: the clerks speak well of the man who did it.",
          "to": "HBC"
        }
      ]
    },
    {
      "id": "the-merger",
