campaign "The Pemmican War, 1811-1821"
description "The historical arc: Selkirk's colony, the Pemmican Proclamation, Seven Oaks, Fort William seized, the lawless years, and the union of the companies. The blockade and the colony's founding are fixed; the rest is pressure the world may or may not answer, unless you ask for it to be held to."
note "Generated by tools/campaign/camp.py build from tools/campaign/src/historical.camp - edit that, not this."
posts_by_founding_year

beat blockade fixed 1811-06-01 "The Continental Blockade holds the fur market down"
  happens
    london price=0.85 quota=0.85
    flag blockade

beat red-river-grant fixed 1811-06-12 "Lord Selkirk's grant of Assiniboia (the Red River Colony)"
  keywords Selkirk, "Red River", colony, Assiniboia
  happens
    flag red_river_colony
    news from="the Governor and Committee, London" to=factor days=70 subject="Lord Selkirk's grant"
      text "The Committee has granted Lord Selkirk a hundred and sixteen thousand square miles on the Red River for a settlement. Settlers will come out by the Bay. Give them every assistance; the Canadians will not like it."

beat war-of-1812 fixed 1812-06-18 "War between Britain and the United States"
  keywords war, Americans, Montreal
  happens
    news from=Montreal to=partner days=75 company=NWC subject="war with the Americans"
      text "The Americans have declared war. Michilimackinac is in danger and the canoes may be wanted for the King's service."
    news from="the Governor and Committee, London" to=factor days=400 subject="the American war"
      text "Britain is at war with the United States. The ship may be late; ration accordingly."

beat astoria-sold fixed 1813-10-16 "Astor's Fort Astoria sold to the North West Company (Fort George)"
  keywords Astoria, Columbia, "Fort George"
  happens
    flag fort_george
    news from="Fort William" to=partner days=250 company=NWC subject="Astoria is ours"
      text "Astor's men on the Columbia have sold out to us. Fort Astoria is Fort George now, and many of his clerks are Nor'Westers."

beat pemmican-proclamation event 1814-01-08 "Governor Macdonell's Pemmican Proclamation"
  window 60
  lead 120
  requires red-river-grant
  keywords pemmican, "Red River", Macdonell, proclamation, provisions
  done_when flag(pemmican_proclamation)
  pressure
    tension +10 "word that the colony's governor means to stop the pemmican"
  happens
    flag pemmican_proclamation
    tension +20 "the Pemmican Proclamation"
    news from="Fort Gibraltar" to=partner days=45 company=NWC subject="the Pemmican Proclamation"
      text "Macdonell has forbidden any provisions to leave the colony's lands. Our brigades eat pemmican or they do not run. The partners will not stand it."
    news from="Red River" to=factor days=120 subject="the governor's proclamation"
      text "Governor Macdonell has proclaimed that no pemmican may be taken out of Assiniboia. The Nor'Westers are furious; keep your people close."

beat colony-dispersed event 1815-06-25 "The Red River Colony attacked and dispersed"
  window 60
  requires pemmican-proclamation
  keywords "Red River", colony, settlers, burned
  done_when flag(colony_dispersed)
  pressure
    tension +8 "the M\u00e9tis gathering against the colony"
  happens
    flag colony_dispersed
    tension +15 "the colony burned out"
    news from="Norway House" to=factor days=40 subject="the colony broken up"
      text "The settlers at Red River have been driven off and their houses burned. Some are coming down to the Bay."

beat seven-oaks event 1816-06-19 "The Battle of Seven Oaks: Governor Semple and twenty colonists killed"
  window 45
  requires pemmican-proclamation
  keywords "Seven Oaks", Semple, Grant, Métis, "Red River"
  done_when flag(seven_oaks)
  pressure
    tension +15 "Cuthbert Grant's riders on the Assiniboine"
  happens
    flag seven_oaks
    flag governor_killed
    tension +25 "Seven Oaks"
    news from="Norway House" to=factor days=35 subject="Seven Oaks"
      text "Governor Semple is dead with twenty of the colonists, shot down at Seven Oaks by Grant's half-breeds. The colony is gone."
    news from="Fort William" to=partner days=60 company=NWC subject="Seven Oaks"
      text "Grant's people met Semple at Seven Oaks. Semple is dead and the colony scattered. There will be a reckoning for this in Montreal."

beat selkirk-fort-william conditional "Lord Selkirk marches on Fort William and arrests the partners"
  lead 0
  delay 420
  requires seven-oaks
  keywords Selkirk, "Fort William", "de Meurons", soldiers
  when flag(governor_killed)
  happens
    flag fort_william_seized
    tension +10 "Fort William taken"
    news from="Fort William" to=partner days=70 company=NWC subject="Fort William taken"
      text "Selkirk came up the lakes with his de Meurons and took Fort William. McGillivray and the partners are under arrest."

beat blockade-lifted fixed 1814-05-30 "Peace in Europe: the fur market reopens"
  happens
    unflag blockade
    london price=1.18 quota=1.15
    news from="the Governor and Committee, London" to=factor days=80 subject=peace
      text "Bonaparte is beaten and the Continent is open again. Furs will sell; the Committee expects returns to answer."

beat interior-war-1818 pressure 1818-06-01 "The lawless years: posts burned, brigades stopped"
  requires seven-oaks
  keywords burned, brigade, seized
  pressure
    tension +15 "the interior war"

beat interior-war-1819 pressure 1819-06-01 "The lawless years: Grand Rapids"
  requires seven-oaks
  keywords "Grand Rapids", brigade, seized
  pressure
    tension +15 "the interior war"

beat interior-war-1820 pressure 1820-06-01 "The lawless years: both companies near the end of their means"
  requires seven-oaks
  keywords ruin, debts, London
  pressure
    tension +10 "the interior war"
    london price=0.85 quota=0.9

beat merger event 1821-03-26 "The union of the Hudson's Bay and North West Companies"
  window 120
  lead 365
  keywords union, merger, coalition, Simpson, "the new company"
  done_when flag(merger)
  pressure
    london price=0.9 quota=0.9
  happens
    flag merger
    tension -70 "the companies made one"
    news from="the Governor and Committee, London" to=factor days=90 subject="the union of the companies"
      text "The Company and the North West Company are joined under the Company's charter. Mr. George Simpson will govern the Northern Department. Expect economies."
    news from=Montreal to=partner days=75 company=NWC subject="the coalition"
      text "It is done: the North West Company goes into the Hudson's Bay Company. The wintering partners are to be chief factors and chief traders. Many of the men will be let go."

# ---- the brigades ------------------------------------------------------------------
# The boats on the rivers (Data/World/brigade_runs.json) are what this campaign leans
# on once the quarrel is hot: goods and provisions that do not arrive, boats that are
# held, lost or turned back. Each of these acts on a run by name and reads what the
# boats have already done (convoy_late, convoy_lost...) rather than deciding it.

beat war-slows-the-canoes conditional "The war on the Lakes slows the Montreal canoes"
  requires war-of-1812
  when after(1812-07-17) and before(1815-01-01) and month(5-9)
  repeat 40
  happens
    brigade "the Montreal canoes" delay days=4
    stock "Fort William" Powder -5
    # the delays go on all summer; the partners only say so the first two times
    if count(war-slows-the-canoes) < 2:
      say "Word from the Lakes: the war has the Montreal traffic stopped at every carrying place, and powder goes to the King's service first." to=NWC

beat goods-flow-1814 conditional "The blockade lifts and the outfit comes freely"
  requires blockade-lifted
  happens
    stock "York Factory" TradeGoods +40
    stock "York Factory" PointBlanket +10
    stock "Fort William" TradeGoods +40
    say "Peace in Europe, and a full outfit at last: the shelves at York Factory and Fort William are stocked as they have not been in years." headline

beat pemmican-starves-the-canoes conditional "The Proclamation empties the canoes' provisions"
  requires pemmican-proclamation
  when month(5-9) and not flag(colony_dispersed)
  repeat 40
  happens
    add pemmican_shortage += 1
    stock "Fort Bas de la Riviere" Pemmican -15
    stock "Fort Augustus" Pemmican -10
    brigade "the Saskatchewan canoes" delay days=5
    if $pemmican_shortage >= 3:
      tension +3 "the canoes go hungry while the colony holds the pemmican"
      say "The Saskatchewan canoes are on short commons for the third summer running: the Proclamation is starving the brigades, and the partners are saying so." to=NWC headline
    else:
      say "Pemmican is short on the Saskatchewan: the canoes lie up to hunt." to=NWC

beat fort-william-stood-down conditional "Selkirk's soldiers hold Fort William"
  requires selkirk-fort-william
  happens
    brigade "the Montreal canoes" cancel
    stock "Fort William" TradeGoods -60
    stock "Fort William" Pemmican -30
    say "Lord Selkirk's soldiers hold Fort William. The Montreal canoes are stood down and the stores are under guard." to=NWC headline
    after 60 days:
      say "Fort William is given back to the partners, with its stores a good deal lighter." to=NWC

beat interior-ambushes conditional "The interior war reaches the brigades"
  requires seven-oaks
  when month(5-9) and tension >= 50 and not flag(merger) and chance(25)
  repeat 60
  happens
    add interior_incidents += 1
    tension +1 "an incident on the brigade roads"
    random:
      35%:
        brigade "the Saskatchewan canoes" turn_back
      25%:
        brigade "the Saskatchewan brigade" delay days=6
      25%:
        brigade "the Athabasca brigade" lose
      15%:
        say "A rumour of shots at a carrying place; nothing came of it this time."

beat boats-lost-london conditional "A boat lost on the road, and London hears of it"
  when convoy_lost("the York boats") or convoy_lost("the Saskatchewan brigade")
  repeat 300
  happens
    london price=0.97 quota=0.92
    news from="Cumberland House" to=factor days=25 company=HBC
      subject "Boats lost on the road"
      text "A boat has gone down with its pieces on the way, and men with it. The returns will be short this summer, and the Committee will want to know why."

beat york-boats-overdue conditional "The York boats are late for the ship"
  when convoy_late("the York boats") and month(7-9)
  repeat 300
  happens
    say "The York boats are overdue and the ship is nearly due: the Factor walks the wharf at all hours." to=HBC
    after 20 days:
      if convoy_late("the York boats"):
        london quota=0.95
        say "The boats are still not in. The ship will go home light and the Committee will hear it from the Factor." to=HBC headline

beat edmonton-goes-to-the-rival conditional "Edmonton House has nothing to trade"
  when stock("Edmonton House", TradeGoods) < 10 and month(10-12) and post("Fort Augustus")
  repeat 365
  happens
    stock "Fort Augustus" BeaverPelt +15
    say "Edmonton House has nothing left on its shelves, and the Piegans are taking their furs next door to Fort Augustus." to=HBC headline

beat canoes-stood-down conditional "The North West Company's canoes are stood down"
  requires merger
  happens
    brigade "the Montreal canoes" cancel
    brigade "the Saskatchewan canoes" cancel
    brigade "the Athabasca brigade" cancel
    say "The two companies are one. The canoes are stood down; the brigades will run under a single flag." to=NWC headline
