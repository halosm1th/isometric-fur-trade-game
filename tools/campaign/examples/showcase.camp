# Every feature of the language in one small campaign. Not for play.
campaign "Showcase"
description "A tour of the campaign language."
posts_by_founding_year
seed 7

macro dispatch(to, subject, days=40):
  news from="Montreal" to={{to}} subject={{subject}} days={{days}}

beat first fixed 1812-06-01 "A fixed beat"
  keywords war, "Red River"
  happens
    set mood = 1
    flag first-done
    use dispatch to=factor subject="Hello" days=30

beat reacts conditional "Reacts to brigades and the calendar"
  requires first
  when convoy_late("the York boats") or (month(6-8) and stock("York Factory", Rum) < 20)
  when not flag(calm)
  delay 3
  repeat 200
  happens
    add mood += 1
    if $mood >= 3:
      say "Things are bad." to=HBC headline
    elif tension >= 50:
      tension -5 "a cooling"
    else:
      stock "York Factory" Rum -5
    random:
      30%:
        brigade "the York boats" delay days=4
      70%:
        brigade "the York boats" lose
    after 14 days:
      flag later
      trigger the-end

beat the-end event 1815-01-01 "Ends, if asked or left alone"
  window 30
  lead 60
  done_when flag(world-did-it)
  pressure
    tension +5 "the end is near"
  happens
    news from=Montreal to=partner company=NWC days=40
      subject "A long letter"
      text """
      First line.

      Second paragraph, with "quotes".
      """

for y in 1818, 1819:
  beat interior-war-{{y}} pressure {{y}}-06-01
    requires first
