// The Pemmican War, 1811-1821, as the game plays it.
//
// This file is the source of Campaigns/historical.json. Edit it here and run
//     dotnet run --project tools/CampaignTool -- build
// (or open it in the web editor: dotnet run --project tools/CampaignTool -- serve).
//
// It has two halves. The dated history comes first: the blockade, Selkirk's
// grant, the war, the Proclamation, Seven Oaks, the merger. Those beats are
// fixed or are pressure the world may or may not answer. After them come the
// beats that act on the brigades on the rivers (Data/World/brigade_runs.json):
// they read what the boats have already done - brigade("...").isLate, isLost -
// and press on them.

campaign Historical(
    title: "The Pemmican War, 1811-1821",
    description: "The historical arc: Selkirk's colony, the Pemmican Proclamation, " +
                 "Seven Oaks, Fort William seized, the lawless years, and the " +
                 "union of the companies. The blockade and the colony's founding " +
                 "are fixed; the rest is pressure the world may or may not answer, " +
                 "unless you ask for it to be held to.",
    note: "Generated by tools/CampaignTool (build) from " +
          "tools/CampaignTool/src/historical.camp - edit that, not this.",
    postsByFoundingYear: true,
    include: "lakes-war"   // the war of 1812 on the Lakes frontier (src/parts/lakes-war.camp)
);

int interior_incidents;
int pemmican_shortage;

// ---- the dated history ----------------------------------------------------

beat Blockade(
    id: "blockade",
    title: "The Continental Blockade holds the fur market down",
    date: date(1811, 6, 1)
) {
    OnActivate() {
        world.setLondon(0.85, 0.85);
        flags.set("blockade");
    }
}

beat RedRiverGrant(
    id: "red-river-grant",
    title: "Lord Selkirk's grant of Assiniboia (the Red River Colony)",
    date: date(1811, 6, 12),
    keywords: ["Selkirk", "Red River", "colony", "Assiniboia"]
) {
    OnActivate() {
        flags.set("red_river_colony");
        news(
            from: "the Governor and Committee, London",
            to: Person.Factor,
            subject: "Lord Selkirk's grant",
            text: "The Committee has granted Lord Selkirk a hundred and sixteen " +
                  "thousand square miles on the Red River for a settlement. " +
                  "Settlers will come out by the Bay. Give them every assistance; " +
                  "the Canadians will not like it.",
            days: 70
        );
    }
}

beat WarOf1812(
    id: "war-of-1812",
    title: "War between Britain and the United States",
    date: date(1812, 6, 18),
    keywords: ["war", "Americans", "Montreal"]
) {
    OnActivate() {
        news(
            from: "Montreal",
            to: Person.Partner,
            subject: "war with the Americans",
            text: "The Americans have declared war. Michilimackinac is in danger " +
                  "and the canoes may be wanted for the King's service.",
            days: 75,
            company: Company.NWC
        );
        news(
            from: "the Governor and Committee, London",
            to: Person.Factor,
            subject: "the American war",
            text: "Britain is at war with the United States. The ship may be late; " +
                  "ration accordingly.",
            days: 400
        );
    }
}

beat AstoriaSold(
    id: "astoria-sold",
    title: "Astor's Fort Astoria sold to the North West Company (Fort " +
           "George)",
    date: date(1813, 10, 16),
    keywords: ["Astoria", "Columbia", "Fort George"]
) {
    OnActivate() {
        flags.set("fort_george");
        news(
            from: "Fort William",
            to: Person.Partner,
            subject: "Astoria is ours",
            text: "Astor's men on the Columbia have sold out to us. Fort Astoria is " +
                  "Fort George now, and many of his clerks are Nor'Westers.",
            days: 250,
            company: Company.NWC
        );
    }
}

beat PemmicanProclamation(
    kind: Kind.Fixed,   // history: it happens on its day (an event with no way for the world to do it never happened at Steady)
    id: "pemmican-proclamation",
    title: "Governor Macdonell's Pemmican Proclamation",
    date: date(1814, 1, 8),
    window: days(60),
    lead: days(120),
    keywords: ["pemmican", "Red River", "Macdonell", "proclamation", "provisions"],
    rumour: "They say the governor at the Forks means to forbid any pemmican to leave the colony."
) [RedRiverGrant] {
    OnApproach() {
        world.raiseTension(10, "word that the colony's governor means to stop the pemmican");
    }
    OnActivate() {
        flags.set("pemmican_proclamation");
        world.raiseTension(20, "the Pemmican Proclamation");
        news(
            from: "Fort Gibraltar",
            to: Person.Partner,
            subject: "the Pemmican Proclamation",
            text: "Macdonell has forbidden any provisions to leave the colony's " +
                  "lands. Our brigades eat pemmican or they do not run. The " +
                  "partners will not stand it.",
            days: 45,
            company: Company.NWC
        );
        news(
            from: "Red River",
            to: Person.Factor,
            subject: "the governor's proclamation",
            text: "Governor Macdonell has proclaimed that no pemmican may be taken " +
                  "out of Assiniboia. The Nor'Westers are furious; keep your people " +
                  "close.",
            days: 120
        );
    }
}

beat ColonyDispersed(
    kind: Kind.Fixed,   // history: it happens on its day (an event with no way for the world to do it never happened at Steady)
    id: "colony-dispersed",
    title: "The Red River Colony attacked and dispersed",
    date: date(1815, 6, 25),
    window: days(60),
    keywords: ["Red River", "colony", "settlers", "burned"],
    rumour: "The Metis talk of driving the settlers from the Forks before another winter."
) [PemmicanProclamation] {
    OnApproach() {
        world.raiseTension(8, "the Métis gathering against the colony");
    }
    OnActivate() {
        flags.set("colony_dispersed");
        world.raiseTension(15, "the colony burned out");
        news(
            from: "Norway House",
            to: Person.Factor,
            subject: "the colony broken up",
            text: "The settlers at Red River have been driven off and their houses " +
                  "burned. Some are coming down to the Bay.",
            days: 40
        );
    }
}

beat SevenOaks(
    kind: Kind.Fixed,   // history: it happens on its day (an event with no way for the world to do it never happened at Steady)
    id: "seven-oaks",
    title: "The Battle of Seven Oaks: Governor Semple and twenty colonists " +
           "killed",
    date: date(1816, 6, 19),
    window: days(45),
    keywords: ["Seven Oaks", "Semple", "Grant", "Métis", "Red River"],
    rumour: "Grant's riders are gathering on the Assiniboine, and the colony's governor is on the road out from Fort Douglas."
) [PemmicanProclamation] {
    OnApproach() {
        world.raiseTension(15, "Cuthbert Grant's riders on the Assiniboine");
    }
    OnActivate() {
        flags.set("seven_oaks");
        flags.set("governor_killed");
        world.raiseTension(25, "Seven Oaks");
        news(
            from: "Norway House",
            to: Person.Factor,
            subject: "Seven Oaks",
            text: "Governor Semple is dead with twenty of the colonists, shot down " +
                  "at Seven Oaks by Grant's half-breeds. The colony is gone.",
            days: 35
        );
        news(
            from: "Fort William",
            to: Person.Partner,
            subject: "Seven Oaks",
            text: "Grant's people met Semple at Seven Oaks. Semple is dead and the " +
                  "colony scattered. There will be a reckoning for this in " +
                  "Montreal.",
            days: 60,
            company: Company.NWC
        );
    }
}

beat SelkirkFortWilliam(
    kind: Kind.Conditional,   // history: it happens once the governor is dead and the delay has run (as an event it never happened at Steady)
    id: "selkirk-fort-william",
    title: "Lord Selkirk marches on Fort William and arrests the partners",
    lead: days(0),
    delay: days(55),    // 19 June to 13 August 1816
    keywords: ["Selkirk", "Fort William", "de Meurons", "soldiers"],
    rumour: "Word is Lord Selkirk has hired soldiers for the north and means to come up the lakes."
) [SevenOaks] {
    AwakenWhen() => flags.has("governor_killed");
    OnActivate() {
        flags.set("fort_william_seized");
        world.raiseTension(10, "Fort William taken");
        news(
            from: "Fort William",
            to: Person.Partner,
            subject: "Fort William taken",
            text: "Selkirk came up the lakes with his de Meurons and took Fort " +
                  "William. McGillivray and the partners are under arrest.",
            days: 70,
            company: Company.NWC
        );
    }
}

beat BlockadeLifted(
    id: "blockade-lifted",
    title: "Peace in Europe: the fur market reopens",
    date: date(1814, 5, 30)
) {
    OnActivate() {
        flags.clear("blockade");
        world.setLondon(1.18, 1.15);
        news(
            from: "the Governor and Committee, London",
            to: Person.Factor,
            subject: "peace",
            text: "Bonaparte is beaten and the Continent is open again. Furs will " +
                  "sell; the Committee expects returns to answer.",
            days: 80
        );
    }
}

beat InteriorWar1818(
    kind: Kind.Fixed,   // history: it happens on its day (an event with no way for the world to do it never happened at Steady)
    id: "interior-war-1818",
    title: "The lawless years: posts burned, brigades stopped",
    date: date(1818, 6, 1),
    keywords: ["burned", "brigade", "seized"]
) [SevenOaks] {
    OnApproach() {
        world.raiseTension(15, "the interior war");
    }
}

beat InteriorWar1819(
    kind: Kind.Fixed,   // history: it happens on its day (an event with no way for the world to do it never happened at Steady)
    id: "interior-war-1819",
    title: "The lawless years: Grand Rapids",
    date: date(1819, 6, 1),
    keywords: ["Grand Rapids", "brigade", "seized"]
) [SevenOaks] {
    OnApproach() {
        world.raiseTension(15, "the interior war");
    }
}

beat InteriorWar1820(
    kind: Kind.Fixed,   // history: it happens on its day (an event with no way for the world to do it never happened at Steady)
    id: "interior-war-1820",
    title: "The lawless years: both companies near the end of their means",
    date: date(1820, 6, 1),
    keywords: ["ruin", "debts", "London"]
) [SevenOaks] {
    OnApproach() {
        world.raiseTension(10, "the interior war");
        world.setLondon(0.85, 0.9);
    }
}

beat Merger(
    kind: Kind.Fixed,   // history: it happens on its day (an event with no way for the world to do it never happened at Steady)
    id: "merger",
    title: "The union of the Hudson's Bay and North West Companies",
    date: date(1821, 3, 26),
    window: days(120),
    lead: days(365),
    keywords: ["union", "merger", "coalition", "Simpson", "the new company"],
    rumour: "There is talk in London and in Montreal of a union of the two companies."
) {
    OnApproach() {
        world.setLondon(0.9, 0.9);
    }
    OnActivate() {
        flags.set("merger");
        world.raiseTension(-70, "the companies made one");
        news(
            from: "the Governor and Committee, London",
            to: Person.Factor,
            subject: "the union of the companies",
            text: "The Company and the North West Company are joined under the " +
                  "Company's charter. Mr. George Simpson will govern the Northern " +
                  "Department. Expect economies.",
            days: 90
        );
        news(
            from: "Montreal",
            to: Person.Partner,
            subject: "the coalition",
            text: "It is done: the North West Company goes into the Hudson's Bay " +
                  "Company. The wintering partners are to be chief factors and " +
                  "chief traders. Many of the men will be let go.",
            days: 75,
            company: Company.NWC
        );
    }
}

// ---- the brigades on the rivers -------------------------------------------
//
// These happen whenever their conditions hold, and again after their repeat
// time, for as long as the world keeps giving them cause.

beat WarSlowsTheCanoes(
    id: "war-slows-the-canoes",
    title: "The war on the Lakes slows the Montreal canoes",
    repeat: days(40)
) [WarOf1812] {
    AwakenWhen() => world.date >= date(1812, 7, 17)
        && world.date < date(1815, 1, 1)
        && world.inMonths(5, 9);
    OnActivate() {
        brigade("the Montreal canoes").delay(4);
        world.addStock("Fort William", Item.Powder, -5);
        if (WarSlowsTheCanoes.count < 2) {
            say("Word from the Lakes: the war has the Montreal traffic stopped at " +
                "every carrying place, and powder goes to the King's service " +
                "first.", Company.NWC);
        }
    }
}

beat GoodsFlow1814(
    id: "goods-flow-1814",
    title: "The blockade lifts and the outfit comes freely"
) [BlockadeLifted] {
    OnActivate() {
        world.addStock("York Factory", Item.TradeGoods, 40);
        world.addStock("York Factory", Item.PointBlanket, 10);
        world.addStock("Fort William", Item.TradeGoods, 40);
        shout("Peace in Europe, and a full outfit at last: the shelves at York " +
              "Factory and Fort William are stocked as they have not been in " +
              "years.");
    }
}

beat PemmicanStarvesTheCanoes(
    id: "pemmican-starves-the-canoes",
    title: "The Proclamation empties the canoes' provisions",
    repeat: days(40)
) [PemmicanProclamation] {
    AwakenWhen() => world.inMonths(5, 9) && !flags.has("colony_dispersed");
    OnActivate() {
        pemmican_shortage += 1;
        world.addStock("Fort Bas de la Riviere", Item.Pemmican, -15);
        world.addStock("Fort Augustus", Item.Pemmican, -10);
        brigade("the Saskatchewan canoes").delay(5);
        if (pemmican_shortage >= 3) {
            world.raiseTension(3, "the canoes go hungry while the colony holds the pemmican");
            shout("The Saskatchewan canoes are on short commons for the third " +
                  "summer running: the Proclamation is starving the brigades, and " +
                  "the partners are saying so.", Company.NWC);
        } else {
            say("Pemmican is short on the Saskatchewan: the canoes lie up to " +
                "hunt.", Company.NWC);
        }
    }
}

beat FortWilliamStoodDown(
    id: "fort-william-stood-down",
    title: "Selkirk's soldiers hold Fort William"
) [SelkirkFortWilliam] {
    OnActivate() {
        brigade("the Montreal canoes").cancel();
        world.addStock("Fort William", Item.TradeGoods, -60);
        world.addStock("Fort William", Item.Pemmican, -30);
        shout("Lord Selkirk's soldiers hold Fort William. The Montreal canoes " +
              "are stood down and the stores are under guard.", Company.NWC);
        after(days(60), () => {
            say("Fort William is given back to the partners, with its stores a " +
                "good deal lighter.", Company.NWC);
        });
    }
}

beat InteriorAmbushes(
    id: "interior-ambushes",
    title: "The interior war reaches the brigades",
    repeat: days(60),
    rumour: "Shots are said to have been heard along the brigade roads."
) [SevenOaks] {
    AwakenWhen() => world.inMonths(5, 9)
        && world.tension >= 50
        && !flags.has("merger")
        && chance(25);
    OnActivate() {
        interior_incidents += 1;
        world.raiseTension(1, "an incident on the brigade roads");
        random(
            option(35, () => {
                brigade("the Saskatchewan canoes").turnBack();
            }),
            option(25, () => {
                brigade("the Saskatchewan brigade").delay(6);
            }),
            option(25, () => {
                brigade("the Athabasca brigade").lose();
            }),
            option(15, () => {
                say("A rumour of shots at a carrying place; nothing came of it this " +
                    "time.");
            })
        );
    }
}

beat BoatsLostLondon(
    id: "boats-lost-london",
    title: "A boat lost on the road, and London hears of it",
    repeat: days(300)
) {
    AwakenWhen() => brigade("the York boats").isLost || brigade("the Saskatchewan brigade").isLost;
    OnActivate() {
        world.setLondon(0.97, 0.92);
        news(
            from: "Cumberland House",
            to: Person.Factor,
            subject: "Boats lost on the road",
            text: "A boat has gone down with its pieces on the way, and men with " +
                  "it. The returns will be short this summer, and the Committee " +
                  "will want to know why.",
            days: 25,
            company: Company.HBC
        );
    }
}

beat YorkBoatsOverdue(
    id: "york-boats-overdue",
    title: "The York boats are late for the ship",
    repeat: days(300),
    rumour: "The York boats are not yet in."
) {
    AwakenWhen() => brigade("the York boats").isLate && world.inMonths(7, 9);
    OnActivate() {
        say("The York boats are overdue and the ship is nearly due: the " +
            "Factor walks the wharf at all hours.", Company.HBC);
        after(days(20), () => {
            if (brigade("the York boats").isLate) {
                world.setLondon(1, 0.95);
                shout("The boats are still not in. The ship will go home light and the " +
                      "Committee will hear it from the Factor.", Company.HBC);
            }
        });
    }
}

beat EdmontonGoesToTheRival(
    id: "edmonton-goes-to-the-rival",
    title: "Edmonton House has nothing to trade",
    repeat: days(365)
) {
    AwakenWhen() => world.stock("Edmonton House", Item.TradeGoods) < 10
        && world.inMonths(10, 12)
        && world.hasPost("Fort Augustus");
    OnActivate() {
        world.addStock("Fort Augustus", Item.BeaverPelt, 15);
        shout("Edmonton House has nothing left on its shelves, and the Piegans " +
              "are taking their furs next door to Fort Augustus.", Company.HBC);
    }
}

beat CanoesStoodDown(
    id: "canoes-stood-down",
    title: "The North West Company's canoes are stood down"
) [Merger] {
    OnActivate() {
        brigade("the Montreal canoes").cancel();
        brigade("the Saskatchewan canoes").cancel();
        brigade("the Athabasca brigade").cancel();
        shout("The two companies are one. The canoes are stood down; the " +
              "brigades will run under a single flag.", Company.NWC);
    }
}
