campaign Historical;

{ The Pemmican War, 1811-1821, as the game plays it. This file is the source of
  Campaigns/historical.json: edit it here and run
      dotnet run --project tools/CampaignTool -- build
  The first thirteen beats are the dated history (the blockade, Selkirk's
  grant, the war, the Proclamation, Seven Oaks, the merger); the rest act on
  the brigades on the rivers (Data/World/brigade_runs.json). They read what the
  boats have already done - ConvoyLate, ConvoyLost... - and press on them. }

const
  Title = 'The Pemmican War, 1811-1821';
  Description = 'The historical arc: Selkirk''s colony, the Pemmican Proclamation, ' +
                'Seven Oaks, Fort William seized, the lawless years, and the ' +
                'union of the companies. The blockade and the colony''s founding ' +
                'are fixed; the rest is pressure the world may or may not answer, ' +
                'unless you ask for it to be held to.';
  Note = 'Generated by tools/CampaignTool (build) from ' +
         'tools/CampaignTool/src/historical.camp - edit that, not this.';
  PostsByFoundingYear = true;

var
  interior_incidents, pemmican_shortage : integer;

beat 'blockade' : fixed on 1811-06-01
    'The Continental Blockade holds the fur market down';
  happens
  begin
    London(0.85, 0.85);
    Flag('blockade');
  end;
end;

beat 'red-river-grant' : fixed on 1811-06-12
    'Lord Selkirk''s grant of Assiniboia (the Red River Colony)';
  keywords 'Selkirk', 'Red River', 'colony', 'Assiniboia';
  happens
  begin
    Flag('red_river_colony');
    News('the Governor and Committee, London',
         Factor,
         'Lord Selkirk''s grant',
         'The Committee has granted Lord Selkirk a hundred and sixteen ' +
         'thousand square miles on the Red River for a settlement. ' +
         'Settlers will come out by the Bay. Give them every assistance; ' +
         'the Canadians will not like it.',
         70);
  end;
end;

beat 'war-of-1812' : fixed on 1812-06-18
    'War between Britain and the United States';
  keywords 'war', 'Americans', 'Montreal';
  happens
  begin
    News('Montreal',
         Partner,
         'war with the Americans',
         'The Americans have declared war. Michilimackinac is in danger ' +
         'and the canoes may be wanted for the King''s service.',
         75,
         NWC);
    News('the Governor and Committee, London',
         Factor,
         'the American war',
         'Britain is at war with the United States. The ship may be late; ' +
         'ration accordingly.',
         400);
  end;
end;

beat 'astoria-sold' : fixed on 1813-10-16
    'Astor''s Fort Astoria sold to the North West Company (Fort ' +
    'George)';
  keywords 'Astoria', 'Columbia', 'Fort George';
  happens
  begin
    Flag('fort_george');
    News('Fort William',
         Partner,
         'Astoria is ours',
         'Astor''s men on the Columbia have sold out to us. Fort Astoria is ' +
         'Fort George now, and many of his clerks are Nor''Westers.',
         250,
         NWC);
  end;
end;

beat 'pemmican-proclamation' : event on 1814-01-08
    'Governor Macdonell''s Pemmican Proclamation';
  window 60;
  lead 120;
  requires 'red-river-grant';
  keywords 'pemmican', 'Red River', 'Macdonell', 'proclamation', 'provisions';
  done when Flag('pemmican_proclamation');
  pressure
  begin
    Tension(10, 'word that the colony''s governor means to stop the pemmican');
  end;
  happens
  begin
    Flag('pemmican_proclamation');
    Tension(20, 'the Pemmican Proclamation');
    News('Fort Gibraltar',
         Partner,
         'the Pemmican Proclamation',
         'Macdonell has forbidden any provisions to leave the colony''s ' +
         'lands. Our brigades eat pemmican or they do not run. The ' +
         'partners will not stand it.',
         45,
         NWC);
    News('Red River',
         Factor,
         'the governor''s proclamation',
         'Governor Macdonell has proclaimed that no pemmican may be taken ' +
         'out of Assiniboia. The Nor''Westers are furious; keep your people ' +
         'close.',
         120);
  end;
end;

beat 'colony-dispersed' : event on 1815-06-25
    'The Red River Colony attacked and dispersed';
  window 60;
  requires 'pemmican-proclamation';
  keywords 'Red River', 'colony', 'settlers', 'burned';
  done when Flag('colony_dispersed');
  pressure
  begin
    Tension(8, 'the Métis gathering against the colony');
  end;
  happens
  begin
    Flag('colony_dispersed');
    Tension(15, 'the colony burned out');
    News('Norway House',
         Factor,
         'the colony broken up',
         'The settlers at Red River have been driven off and their houses ' +
         'burned. Some are coming down to the Bay.',
         40);
  end;
end;

beat 'seven-oaks' : event on 1816-06-19
    'The Battle of Seven Oaks: Governor Semple and twenty colonists ' +
    'killed';
  window 45;
  requires 'pemmican-proclamation';
  keywords 'Seven Oaks', 'Semple', 'Grant', 'Métis', 'Red River';
  done when Flag('seven_oaks');
  pressure
  begin
    Tension(15, 'Cuthbert Grant''s riders on the Assiniboine');
  end;
  happens
  begin
    Flag('seven_oaks');
    Flag('governor_killed');
    Tension(25, 'Seven Oaks');
    News('Norway House',
         Factor,
         'Seven Oaks',
         'Governor Semple is dead with twenty of the colonists, shot down ' +
         'at Seven Oaks by Grant''s half-breeds. The colony is gone.',
         35);
    News('Fort William',
         Partner,
         'Seven Oaks',
         'Grant''s people met Semple at Seven Oaks. Semple is dead and the ' +
         'colony scattered. There will be a reckoning for this in ' +
         'Montreal.',
         60,
         NWC);
  end;
end;

beat 'selkirk-fort-william' : conditional
    'Lord Selkirk marches on Fort William and arrests the partners';
  lead 0;
  delay 420;
  requires 'seven-oaks';
  keywords 'Selkirk', 'Fort William', 'de Meurons', 'soldiers';
  when Flag('governor_killed');
  happens
  begin
    Flag('fort_william_seized');
    Tension(10, 'Fort William taken');
    News('Fort William',
         Partner,
         'Fort William taken',
         'Selkirk came up the lakes with his de Meurons and took Fort ' +
         'William. McGillivray and the partners are under arrest.',
         70,
         NWC);
  end;
end;

beat 'blockade-lifted' : fixed on 1814-05-30
    'Peace in Europe: the fur market reopens';
  happens
  begin
    Unflag('blockade');
    London(1.18, 1.15);
    News('the Governor and Committee, London',
         Factor,
         'peace',
         'Bonaparte is beaten and the Continent is open again. Furs will ' +
         'sell; the Committee expects returns to answer.',
         80);
  end;
end;

beat 'interior-war-1818' : pressure on 1818-06-01
    'The lawless years: posts burned, brigades stopped';
  requires 'seven-oaks';
  keywords 'burned', 'brigade', 'seized';
  pressure
  begin
    Tension(15, 'the interior war');
  end;
end;

beat 'interior-war-1819' : pressure on 1819-06-01
    'The lawless years: Grand Rapids';
  requires 'seven-oaks';
  keywords 'Grand Rapids', 'brigade', 'seized';
  pressure
  begin
    Tension(15, 'the interior war');
  end;
end;

beat 'interior-war-1820' : pressure on 1820-06-01
    'The lawless years: both companies near the end of their means';
  requires 'seven-oaks';
  keywords 'ruin', 'debts', 'London';
  pressure
  begin
    Tension(10, 'the interior war');
    London(0.85, 0.9);
  end;
end;

beat 'merger' : event on 1821-03-26
    'The union of the Hudson''s Bay and North West Companies';
  window 120;
  lead 365;
  keywords 'union', 'merger', 'coalition', 'Simpson', 'the new company';
  done when Flag('merger');
  pressure
  begin
    London(0.9, 0.9);
  end;
  happens
  begin
    Flag('merger');
    Tension(-70, 'the companies made one');
    News('the Governor and Committee, London',
         Factor,
         'the union of the companies',
         'The Company and the North West Company are joined under the ' +
         'Company''s charter. Mr. George Simpson will govern the Northern ' +
         'Department. Expect economies.',
         90);
    News('Montreal',
         Partner,
         'the coalition',
         'It is done: the North West Company goes into the Hudson''s Bay ' +
         'Company. The wintering partners are to be chief factors and ' +
         'chief traders. Many of the men will be let go.',
         75,
         NWC);
  end;
end;

{ ---- the brigades ---------------------------------------------------------------- }

{ The war on the Lakes, 1812-14: the Montreal traffic is slowed all summer, and the
  partners only say so the first two times. }
beat 'war-slows-the-canoes' : conditional
    'The war on the Lakes slows the Montreal canoes';
  repeat 40;
  requires 'war-of-1812';
  when Today >= 1812-07-17 and Today < 1815-01-01 and InMonths(5, 9);
  happens
  begin
    Brigade('the Montreal canoes', Delay, 4);
    Stock('Fort William', Powder, -5);
    if Count('war-slows-the-canoes') < 2 then
    begin
      Say('Word from the Lakes: the war has the Montreal traffic stopped at ' +
          'every carrying place, and powder goes to the King''s service ' +
          'first.', NWC);
    end;
  end;
end;

{ Peace in Europe: the outfit comes freely again. }
beat 'goods-flow-1814' : conditional
    'The blockade lifts and the outfit comes freely';
  requires 'blockade-lifted';
  happens
  begin
    Stock('York Factory', TradeGoods, 40);
    Stock('York Factory', PointBlanket, 10);
    Stock('Fort William', TradeGoods, 40);
    Shout('Peace in Europe, and a full outfit at last: the shelves at York ' +
          'Factory and Fort William are stocked as they have not been in ' +
          'years.');
  end;
end;

{ The Proclamation (1814-15) keeps pemmican from the canoes that eat it. }
beat 'pemmican-starves-the-canoes' : conditional
    'The Proclamation empties the canoes'' provisions';
  repeat 40;
  requires 'pemmican-proclamation';
  when InMonths(5, 9) and not Flag('colony_dispersed');
  happens
  begin
    Inc(pemmican_shortage, 1);
    Stock('Fort Bas de la Riviere', Pemmican, -15);
    Stock('Fort Augustus', Pemmican, -10);
    Brigade('the Saskatchewan canoes', Delay, 5);
    if pemmican_shortage >= 3 then
    begin
      Tension(3, 'the canoes go hungry while the colony holds the pemmican');
      Shout('The Saskatchewan canoes are on short commons for the third ' +
            'summer running: the Proclamation is starving the brigades, and ' +
            'the partners are saying so.', NWC);
    end
    else
    begin
      Say('Pemmican is short on the Saskatchewan: the canoes lie up to ' +
          'hunt.', NWC);
    end;
  end;
end;

{ Selkirk takes Fort William (August 1816): the canoes are stood down and the stores seized. }
beat 'fort-william-stood-down' : conditional
    'Selkirk''s soldiers hold Fort William';
  requires 'selkirk-fort-william';
  happens
  begin
    Brigade('the Montreal canoes', Cancel);
    Stock('Fort William', TradeGoods, -60);
    Stock('Fort William', Pemmican, -30);
    Shout('Lord Selkirk''s soldiers hold Fort William. The Montreal canoes ' +
          'are stood down and the stores are under guard.', NWC);
    after 60 days do
    begin
      Say('Fort William is given back to the partners, with its stores a ' +
          'good deal lighter.', NWC);
    end;
  end;
end;

{ The lawless years: every six weeks or so of open water, the dice may hold, lose or turn
  back a brigade. Case labels are weights. }
beat 'interior-ambushes' : conditional
    'The interior war reaches the brigades';
  repeat 60;
  requires 'seven-oaks';
  when InMonths(5, 9) and Tension >= 50 and not Flag('merger') and Chance(25);
  happens
  begin
    Inc(interior_incidents, 1);
    Tension(1, 'an incident on the brigade roads');
    case random of
      35:
      begin
        Brigade('the Saskatchewan canoes', TurnBack);
      end;
      25:
      begin
        Brigade('the Saskatchewan brigade', Delay, 6);
      end;
      25:
      begin
        Brigade('the Athabasca brigade', Lose);
      end;
      15:
      begin
        Say('A rumour of shots at a carrying place; nothing came of it this ' +
            'time.');
      end;
    end;
  end;
end;

{ Reactive: the engine raises ConvoyLost / ConvoyLate by itself when it happens on the water. }
beat 'boats-lost-london' : conditional
    'A boat lost on the road, and London hears of it';
  repeat 300;
  when ConvoyLost('the York boats') or ConvoyLost('the Saskatchewan brigade');
  happens
  begin
    London(0.97, 0.92);
    News('Cumberland House',
         Factor,
         'Boats lost on the road',
         'A boat has gone down with its pieces on the way, and men with ' +
         'it. The returns will be short this summer, and the Committee ' +
         'will want to know why.',
         25,
         HBC);
  end;
end;

beat 'york-boats-overdue' : conditional
    'The York boats are late for the ship';
  repeat 300;
  when ConvoyLate('the York boats') and InMonths(7, 9);
  happens
  begin
    Say('The York boats are overdue and the ship is nearly due: the ' +
        'Factor walks the wharf at all hours.', HBC);
    after 20 days do
    begin
      if ConvoyLate('the York boats') then
      begin
        London(1, 0.95);
        Shout('The boats are still not in. The ship will go home light and the ' +
              'Committee will hear it from the Factor.', HBC);
      end;
    end;
  end;
end;

beat 'edmonton-goes-to-the-rival' : conditional
    'Edmonton House has nothing to trade';
  repeat 365;
  when Stock('Edmonton House', TradeGoods) < 10 and InMonths(10, 12) and Post('Fort Augustus');
  happens
  begin
    Stock('Fort Augustus', BeaverPelt, 15);
    Shout('Edmonton House has nothing left on its shelves, and the Piegans ' +
          'are taking their furs next door to Fort Augustus.', HBC);
  end;
end;

beat 'canoes-stood-down' : conditional
    'The North West Company''s canoes are stood down';
  requires 'merger';
  happens
  begin
    Brigade('the Montreal canoes', Cancel);
    Brigade('the Saskatchewan canoes', Cancel);
    Brigade('the Athabasca brigade', Cancel);
    Shout('The two companies are one. The canoes are stood down; the ' +
          'brigades will run under a single flag.', NWC);
  end;
end;

end.
