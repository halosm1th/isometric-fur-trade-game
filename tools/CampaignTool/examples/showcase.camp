campaign Showcase;

{ Every feature of the language in one small campaign. Not for play.

  Pascal's shape, with a few kindnesses: a comparison binds tighter than
  and / or (no brackets round each side), strings may be built with + and
  #10 (a new line), keywords and the built-in names are not case sensitive,
  and your own names and strings are. Reserved words: campaign const var
  procedure beat begin end if then else for to do after days case random of
  and or not on. }

const
  Title = 'Showcase';
  Description = 'A tour of the campaign language.';
  PostsByFoundingYear = true;
  Seed = 7;
  Hot = 50;                       { named constants may be used in conditions }
  Cooling = 'a cooling';

var
  mood, level : integer;          { script variables must be declared; they start at 0 }

{ A procedure is a macro, expanded wherever it is called. }
procedure Dispatch(recipient, subject : string; days : integer);
begin
  News('Montreal', recipient, subject, 'A letter.', days);
end;

beat 'first' : fixed on 1812-06-01 'A fixed beat';
  keywords 'war', 'Red River';
  happens
  begin
    mood := 1;
    Flag('first_done');
    Dispatch(Factor, 'Hello', 30);
  end;
end;

beat 'reacts' : conditional 'Reacts to brigades and the calendar';
  requires 'first';
  when ConvoyLate('the York boats') or InMonths(6, 8) and (Stock('York Factory', Rum) < 20);
  when not Flag('calm');                         { several `when`s must all hold }
  delay 3;
  repeat 200;                                    { happens again this many days later }
  happens
  begin
    Inc(mood);
    if mood >= 3 then
      Shout('Things are bad.', HBC)
    else if Tension >= Hot then
      Tension(-5, Cooling)
    else
      Stock('York Factory', Rum, -5);
    case random of                               { the labels are weights }
      30: Brigade('the York boats', Delay, 4);
      70: Brigade('the York boats', Lose);
    end;
    after 14 days do
    begin
      Flag('later');
      Trigger('the-end');
    end;
  end;
end;

beat 'the-end' : event on 1815-01-01 'Ends, if asked or left alone';
  window 30;
  lead 60;
  done when Flag('world-did-it');
  pressure Tension(5, 'the end is near');
  happens
    News('Montreal', Partner, 'A long letter',
         'First line.' + #10#10 + 'Second paragraph, with "quotes".',
         40, NWC);
end;

{ A loop writes a beat for each year. }
for y := 1818 to 1819 do
  beat 'interior-war-' + y : pressure on y + '-06-01';
    requires 'first';
  end;

end.
